# Site Sentinel Configuration
# Copy this file to .env and update the values

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-this
DEBUG=True

# Monitoring Settings
CHECK_INTERVAL=300
ERROR_THRESHOLD=3
RETRY_COUNT=3
REQUEST_TIMEOUT=10
SCREENSHOT_CACHE_DURATION=3600

# Email Settings (for alerts)
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_RECEIVER=alerts@yourcompany.com
EMAIL_USE_TLS=True

# File Paths
EXCEL_FILE=domainler.xlsx
METADATA_FILE=metadata.json
SCREENSHOTS_DIR=screenshots

# PDF Export Settings
WKHTMLTOPDF_PATH=C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe

# Logging
LOG_LEVEL=INFO
# LOG_FILE=site_sentinel.log

# ========================================
# MULTI-CHANNEL ALERT CONFIGURATION
# ========================================

# SLACK ALERTS
# Create a Slack webhook in your workspace
# Go to: https://api.slack.com/apps → Create New App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts
SLACK_USERNAME=SiteSentinel

# DISCORD ALERTS  
# Create a Discord webhook in your server
# Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK
DISCORD_USERNAME=SiteSentinel

# EMAIL ALERTS (Enhanced SMTP)
# For Gmail: Use app passwords, not your regular password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your-email@gmail.com
RECIPIENT_EMAILS=alert1@example.com,alert2@example.com
SMTP_USE_TLS=true

# SMS ALERTS (TWILIO)
# Sign up at https://www.twilio.com and get your credentials
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
SMS_TO_NUMBERS=+1234567890,+0987654321

# MICROSOFT TEAMS ALERTS
# Create an Incoming Webhook connector in your Teams channel
# Teams Channel → Connectors → Incoming Webhook
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK

# TELEGRAM ALERTS
# Create a bot with @BotFather on Telegram
# Get your bot token and chat IDs
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_IDS=chat-id-1,chat-id-2

# ALERT THRESHOLDS & SETTINGS
# Configure when alerts are triggered
ALERT_ON_DOWN=true
ALERT_ON_SLOW_RESPONSE=true
ALERT_ON_SSL_EXPIRY=true
ALERT_ON_DNS_ISSUES=true
ALERT_ON_LOW_HEALTH_SCORE=true

# Thresholds
SLOW_RESPONSE_THRESHOLD_MS=5000
SSL_EXPIRY_WARNING_DAYS=30
LOW_HEALTH_SCORE_THRESHOLD=50
